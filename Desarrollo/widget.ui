          <property name="styleSheet">
           <string notr="true">QPushButton {
    /* Fondo con degradado tipo metal oscuro */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333, stop:1 #111); 
    color: #f1c40f; /* Texto dorado */
    border: 2px solid #8e44ad; /* Borde púrpura real para resaltar */
    border-radius: 8px;
    padding: 10px;
    font-family: 'serif';
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    /* Efecto cuando el mouse pasa por encima */
    background-color: #f1c40f; 
    color: #000;
    border: 2px solid #fff;
}

QPushButton:pressed {
    /* Efecto al hacer clic */
    background-color: #d4ac0d;
    padding-top: 12px; /* Simula hundimiento */
}</string>
