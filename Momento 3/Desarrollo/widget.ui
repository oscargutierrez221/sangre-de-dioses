     <property name="styleSheet">
      <string notr="true">/* ==========================================================================
   PANEL PRINCIPAL (Estilo Cofre de Bronce/Madera)
   ========================================================================== */
QFrame#frame_menu {
    background-color: rgba(62, 50, 41, 0.85); /* Marrón oscuro translúcido */
    border: 3px double #8c6a46;               /* Doble borde simulando relieve de bronce */
    border-radius: 14px;                       /* Esquinas suavizadas */
}

/* ==========================================================================
   TEXTOS (Ángulo y Fuerza)
   ========================================================================== */
QLabel {
    color: #dfb175;                           /* Dorado viejo/Bronce brillante */
    font-family: &quot;Palatino Linotype&quot;, &quot;Georgia&quot;, serif; /* Tipografía clásica */
    font-size: 15px;
    font-weight: bold;
    background-color: transparent;
    border: none;
}

/* ==========================================================================
   CAJAS NUMÉRICAS (QSpinBox)
   ========================================================================== */
QSpinBox {
    background-color: #2b2017;                /* Fondo interno oscuro */
    color: #ebdcb9;                           /* Texto crema */
    border: 2px solid #5c4531;                /* Borde café */
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    padding: 4px;
    min-height: 25px;
}

/* Botones de subir y bajar del SpinBox */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #4a3828;
    border-left: 1px solid #5c4531;
    width: 18px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #73573f;
}

/* ==========================================================================
   BARRAS DESLIZANTES (QSlider Horizontal)
   ========================================================================== */
QSlider::groove:horizontal {
    border: 1px solid #5c4531;
    height: 6px;
    background: #2b2017;
    border-radius: 3px;
}

/* El indicador redondo que arrastras */
QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #b88d5c, stop:1 #5c4531);
    border: 1px solid #1f1610;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #dfb175;                      /* Brilla al pasar el cursor */
}

/* ==========================================================================
   BOTÓN DE LANZAMIENTO (¡LANZAR!)
   ========================================================================== */
QPushButton#pushButton_lanzar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5c371e, stop:1 #3d2312); /* Degradado madera */
    color: #ebdcb9;
    font-family: &quot;Palatino Linotype&quot;, &quot;Georgia&quot;, serif;
    font-size: 16px;
    font-weight: bold;
    border: 2px solid #8c6a46;                /* Marco de bronce */
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 30px;
}

QPushButton#pushButton_lanzar:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7d4b29, stop:1 #5c371e); /* Se aclara */
    border-color: #dfb175;                    /* Borde resalta en dorado */
    color: #ffffff;
}

QPushButton#pushButton_lanzar:pressed {
    background-color: #2b170b;                /* Efecto hundido */
    padding-top: 10px;                        /* Desplazamiento visual de presión */
}</string>
     </property>
