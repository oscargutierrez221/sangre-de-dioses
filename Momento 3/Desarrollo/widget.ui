     <property name="styleSheet">
      <string notr="true">    color: #FFD700; /* Oro puro */
    font-family: 'Serif'; /* O una fuente imponente que tengas */
    font-size: 24px;
    font-weight: bold;
    background-color: rgba(0, 0, 0, 150); /* Fondo negro semi-transparente */
