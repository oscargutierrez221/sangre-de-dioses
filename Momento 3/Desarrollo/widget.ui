           <string notr="true">QPushButton {
    /* Degradado de azul profundo a azul marino */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1a5276, stop:1 #154360); 
    color: #85c1e9; /* Texto azul claro/agua */
    border: 2px solid #2e86c1; /* Borde azul brillante */
    border-radius: 8px;
    padding: 10px;
    font-family: 'serif';
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    /* Efecto de &quot;espuma de mar&quot; al pasar el mouse */
    background-color: #5dade2; 
    color: white;
    border: 2px solid #a9cce3;
}

QPushButton:pressed {
    background-color: #21618c;
    padding-top: 12px;
}</string>
