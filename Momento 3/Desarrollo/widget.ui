    border: 2px solid #a04000; /* Borde color óxido/bronce oscuro */
    border-radius: 8px;
    padding: 10px;
    font-family: 'serif';
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    /* Efecto de resplandor de lava al pasar el mouse */
